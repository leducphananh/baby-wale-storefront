# Storefront environment — copy to `.env.local` and fill in real values.
#
# EVERYTHING here is PUBLIC by design: NEXT_PUBLIC_* variables are inlined into
# the browser bundle. Never put a Supabase service-role key, database password,
# or any private secret in a NEXT_PUBLIC_* variable or in this file.
# See CLAUDE.md §7 and the frontend-storefront-security skill.

# Shared Supabase project — URL and anon/publishable key ONLY.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Public site origin. Used for metadataBase, canonical URLs, and the robots host.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
